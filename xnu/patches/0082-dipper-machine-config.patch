-ifneq ($(CURRENT_MACHINE_CONFIG),SWEET)
+# sweet's Cortex-A76/A55 and dipper's Cortex-A75/A55 have no pointer
+# authentication: stay plain arm64
+ifneq ($(filter SWEET DIPPER,$(CURRENT_MACHINE_CONFIG)),)
 export ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG := arm64e
 endif
 endif
diff --git a/pexpert/pexpert/arm64/DIPPER.h b/pexpert/pexpert/arm64/DIPPER.h
new file mode 100644
index 0000000..b6c2b4d
--- /dev/null
+++ b/pexpert/pexpert/arm64/DIPPER.h
@@ -0,0 +1,51 @@
+/*
+ * Board config for the Xiaomi Mi 8 ("dipper", Qualcomm SDM845 /
+ * Snapdragon 845): Kryo 385 = Cortex-A75 + Cortex-A55, ARMv8.2, no PAC.
+ *
+ * This header is included immediately after SWEET.h (see board_config.h) and
+ * carries only what dipper needs on top of it. Everything the two boards
+ * share - 16K pages, GICv3 with TrustZone owning Group 0, an INTID 19
+ * virtual timer, PSCI CPU_ON, no pointer authentication - is already in
+ * SWEET.h, and every board-specific number (framebuffer geometry, DRAM
+ * carve-outs, UFS base, GIC base) arrives in the device tree the shim hands
+ * over rather than being compiled in here.
+ *
+ * The facts below were measured on dipper hardware by the shim; none of them
+ * are assumed from the SDM845 documentation, which is wrong about at least
+ * the CPU topology:
+ *
+ *   - MPIDR is flat: Aff1 = core number, Aff0 always 0. The "4+4 cluster"
+ *     picture does not hold on this board - the boot core reads 0x81000000,
+ *     the seven secondaries read 0x8100nn00, and PSCI CPU_ON only returns 0
+ *     with reg = core << 8. The textbook (cluster << 8) | core encoding
+ *     leaves cpu4..cpu7 stuck at ON_PENDING.
+ *   - GICD_CTLR.DS = 0, so EL3 owns the security configuration: ARE_NS and
+ *     GICR_IGROUPR0 are write-ignored from EL1, and every interrupt, the
+ *     timer included, arrives as a Group 1 IRQ through sleh_irq().
+ *   - GICR_TYPER.PLPIS=1 VLPIS=0, i.e. 128 KB redistributor granularity, so
+ *     the SGI/PPI frame sits at redistributor base + 0x10000.
+ *   - CNTFRQ_EL0 = 19.2 MHz.
+ */
+
+#ifndef _PEXPERT_ARM64_DIPPER_H
+#define _PEXPERT_ARM64_DIPPER_H
+
+#define DIPPER                    1
+
+/*
+ * All eight cores (four A75 + four A55) as one homogeneous SMP cluster, the
+ * same policy sweet uses: the scheduler does not know the A75s are faster
+ * (no AMP/P-E clusters yet). MAX_CPUS / MAX_CPU_CLUSTERS come from the
+ * shared SWEET block in board_config.h and are already correct for dipper.
+ */
+
+/*
+ * Qualcomm numbers the architected timer PPIs 1/2/3/0 (secure phys, phys,
+ * virt, hyp) instead of the usual 13/14/11/10, so the virtual timer XNU
+ * uses (CNTV) is INTID 16 + 3 = 19. Confirmed on dipper: the shim's IRQ
+ * handler read ICC_IAR1_EL1 = 19 with INTID 19 pending in Group 1. The
+ * value itself lives in SWEET.h as SWEET_VTIMER_INTID, which the sleh.c
+ * IRQ path reads.
+ */
+
+#endif /* ! _PEXPERT_ARM64_DIPPER_H */
